    "/api/admin/email-sender/update-emails": {
      "post": {
        "summary": "/api/admin/email-sender/update-emails",
        "consumes": [
          "application/json"
        ],
        "parameters": [
          {
            "in": "body",
            "name": "body",
            "required": true,
            "schema": {
              "type": "object",
              "properties": {
                "newEmails": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "id": {
                        "type": "string"
                      },
                      "email": {
                        "type": "string"
                      }
                    },
                    "required": [
                      "id",
                      "email"
                    ]
                  },
                  "example": [
                    {
                      "id": "new-1743409242671",
                      "email": "fede@gmail.com"
                    }
                  ]
                },
                "removedEmails": {
                  "type": "array",
                  "items": {},
                  "example": [
                    null
                  ]
                },
                "token": {
                  "type": "string",
                  "example": "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJlbWFpbCI6ImFzZEBhc2QuY29tIiwiaWF0IjoxNzQyMjIwNzI0LCJleHAiOjE3NDQ4NDg3MjR9.EoVbI-7nyqNd8NHMxBhy8NUA9GYF-YK4r-J-NSOy9Gg"
                },
                "role": {
                  "type": "string",
                  "example": "user"
                },
                "email": {
                  "type": "string",
                  "example": "asd@asd.com"
                }
              }
            }
          }
        ],
        "responses": {
          "401": {
            "description": "Unauthorized"
          },
          "404": {
            "description": "Not Found",
            "schema": {
              "type": "string",
              "example": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n<meta charset=\"utf-8\">\n<title>Error</title>\n</head>\n<body>\n<pre>Cannot POST /api/admin/email-sender/update-emails</pre>\n</body>\n</html>\n"
            }
          }
        },
        "tags": [],
        "security": [
          {
            "authorization": []
          }
        ],
        "produces": [
          "text/html"
        ]
      }
    },
